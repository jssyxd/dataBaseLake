  "storage_specification": {
    "primary_format": "parquet",
    "compression": "zstd",
    "compression_level": 7,
    "row_group_target": 100000,
    "query_engine_compatibility": [
      "Polars",
      "DuckDB",
      "PyArrow",
      "Pandas",
      "C++ Arrow"
    ]
  },
  "governance_contract": {
    "time_index_definition": "UTC Unix Timestamp int64 milliseconds (Left-aligned Bar Open Time)",
    "timestamp_unit": "milliseconds",
    "alignment_rule": "left_open_time",
    "lookahead_bias_guarantee": true,
    "supported_timeframes": [
      "1m",
      "15m",
      "1h",
      "4h",
      "1d"
    ],
    "mandatory_columns": [
      {
        "name": "timestamp",
        "type": "int64",
        "description": "Bar open time in milliseconds since UTC Unix Epoch"
      },
      {
        "name": "datetime",
        "type": "string",
        "description": "Human-readable ISO UTC datetime 'YYYY-MM-DD HH:MM:SS'"
      },
      {
        "name": "open",
        "type": "float64",
        "description": "Bar opening price"
      },
      {
        "name": "high",
        "type": "float64",
        "description": "Bar highest traded price"
      },
      {
        "name": "low",
        "type": "float64",
        "description": "Bar lowest traded price"
      },
      {
        "name": "close",
        "type": "float64",
        "description": "Bar closing price"
      },
      {
        "name": "volume",
        "type": "float64",
        "description": "Traded contract or base asset volume"
      },
      {
        "name": "quote_volume",
        "type": "float64",
        "description": "Traded quote volume in USDT (Crypto specific)"
      },
      {
        "name": "taker_buy_volume",
        "type": "float64",
        "description": "Taker aggressive buy volume for CVD (Crypto specific)"
      }
    ]
  },
